# Server Environment Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=7d
# Frontend domain(s), comma-separated if multiple (e.g. https://stockpulse.vercel.app,https://mycustomdomain.com)
CLIENT_URL=https://your-frontend-app.vercel.app
BCRYPT_SALT_ROUNDS=10

# Platform Super Admin credentials (fixed access to platform admin dashboard)
SUPER_ADMIN_USERNAME=pixelstock
SUPER_ADMIN_PASSWORD=y9fK80dWJKUIJ9p

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
